[worldserver]

########################################
# mod-forever-shaman
#
# Shaman changes for 3.3.5: Ghost Wolf follows mod-mount-scaling's level-scaled mount speed, can
# mine and works indoors. Mining and casting indoors need the optional client patch
# (tools/patch-forever-shaman-dbc.sh).
########################################

#
#    ForeverShaman.GhostWolfSpeed.Enable
#        Description: With mod-mount-scaling installed, Ghost Wolf gets the same level-scaled
#                     speed as a ground mount, from Apprentice or Journeyman Riding. The numbers
#                     come from mod-mount-scaling's own MountScaling.* settings. A shaman without
#                     riding keeps the stock 40%. Indoors it's always the stock 40%, and it never
#                     drops below 40%. Does nothing without mod-mount-scaling or with
#                     MountScaling.Enable = 0.
#        Default:     1
#

ForeverShaman.GhostWolfSpeed.Enable = 1

#
#    ForeverShaman.GhostWolfSpeed.OutOfCombatOnly
#        Description: With 1, Ghost Wolf only gets the mount speed out of combat: entering combat
#                     drops it to the stock 40% and leaving combat brings it back. Mounts can't be
#                     used in combat at all. With 0, it keeps the mount speed in combat too.
#        Default:     1
#

ForeverShaman.GhostWolfSpeed.OutOfCombatOnly = 1

#
#    ForeverShaman.GhostWolfGathering.Enable
#        Description: Let shamans mine (and mine or salvage creature corpses) in Ghost Wolf. Herb
#                     Gathering and Skinning already work in Ghost Wolf. The client checks this
#                     itself, so it also needs the optional client patch
#                     (tools/patch-forever-shaman-dbc.sh); without it the client still says you
#                     can't do that while shapeshifted.
#        Default:     1
#

ForeverShaman.GhostWolfGathering.Enable = 1

#
#    ForeverShaman.GhostWolfIndoors.Enable
#        Description: Let Ghost Wolf be used indoors. Stock Ghost Wolf is outdoors only: it can't
#                     be cast indoors, and walking into a building cancels it. With 1, walking
#                     inside keeps it. Casting it indoors also needs the optional client patch
#                     (tools/patch-forever-shaman-dbc.sh); without it the client still says you
#                     can only use that outdoors.
#        Default:     1
#

ForeverShaman.GhostWolfIndoors.Enable = 1
